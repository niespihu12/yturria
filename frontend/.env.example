# Frontend — Variables de entorno
# Copia como .env.local para desarrollo local.
# NUNCA commits .env.local ni .env con valores reales.

# URL base del backend (sin slash final)
VITE_API_URL=http://localhost:8000/api

# Producción con docker-compose: nginx sirve el SPA y reenvía /api al backend,
# así que basta con VITE_API_URL=/api (valor por defecto de Dockerfile.frontend).
# Si la API vive en otro dominio: VITE_API_URL=https://api.tudominio.com/api
